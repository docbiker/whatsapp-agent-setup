# /etc/systemd/system/<agentname>-listener.service
# CUSTOMIZE: <agentname>, WorkingDirectory, ExecStart, SyslogIdentifier

[Unit]
Description=<AgentName> WhatsApp Listener
After=network-online.target openclaw.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/<agentname>/whatsapp
ExecStart=/usr/bin/node /root/<agentname>/whatsapp/listener.js

# CRITICAL: makes MODELO_API_KEY and other vars available to Node process
EnvironmentFile=-/run/openclaw-env

# Memory protection — Chrome (Puppeteer) has a memory leak
# Without these, Chrome can consume 10+ GB and crash the server
MemoryMax=2G
MemoryHigh=1800M
MemorySwapMax=0
OOMPolicy=stop
OOMScoreAdjust=500
RuntimeMaxSec=43200    # preventive restart every 12h; session persists on disk

Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=<agentname>-listener

[Install]
WantedBy=multi-user.target
